# DuoWatch Environment Variables
# For zero-cost production with Supabase, create a free project at https://supabase.com
# and supply your Project URL and public Anon Key below.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anon Key (Never use the service_role key!)
VITE_SUPABASE_ANON_KEY=

# Default STUN Servers (Comma-separated public free STUN list)
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478

# Local / Dev Fallback Mode (Set to 'true' to allow seamless local testing via BroadcastChannel without active Supabase credentials)
VITE_ENABLE_LOCAL_FALLBACK=true
